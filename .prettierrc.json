{
  "printWidth": 120,
  "singleQuote": true,
  "quoteProps": "preserve",
  "trailingComma": "es5",
  "arrowParens": "avoid",
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    { "files": "*.astro", "options": { "parser": "astro" } },
    { "files": "*.css", "options": { "singleQuote": false } }
  ]
}
