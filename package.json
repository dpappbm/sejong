{
  "name": "sejong",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node --env-file-if-exists=.env scripts/audio/download.mjs --build && npm run format:check && astro check && vitest run && astro build && node scripts/check-built-links.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro",
    "audio:setup": "node scripts/audio/docker.mjs setup",
    "audio:collect": "node scripts/audio/collect-texts.mjs",
    "audio:generate": "node scripts/audio/docker.mjs generate",
    "audio:review": "node scripts/audio/build-review.mjs",
    "audio:pack": "node scripts/audio/pack.mjs",
    "audio:publish": "node scripts/audio/publish.mjs",
    "audio:compare": "node scripts/audio/compare.mjs",
    "audio:download": "node scripts/audio/download.mjs"
  },
  "dependencies": {
    "astro": "^7.4.7",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/qrcode": "^1.5.6",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "sass": "^1.108.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
