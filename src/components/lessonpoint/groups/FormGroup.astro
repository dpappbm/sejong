---
import type { FormGroup, PointId } from '../../../data/types';
import OwnTag from '../../OwnTag.astro';
import Blocks from '../../text/Blocks.astro';
import RichText from '../../text/RichText.astro';
import GroupItem from './GroupItem.astro';

interface Props {
  group: FormGroup;
  pointId: PointId;
}

const { group, pointId } = Astro.props;
---

<details class="own related-group form-group">
  <summary>
    <span class="disclosure-arrow" aria-hidden="true"></span>
    <OwnTag />{' '}
    <b>
      Közös építőelem: <span class="korean">{group.title}</span>
    </b>
  </summary>
  <div class="group-body">
    <Blocks content={group.explanation} />
    <ul class="group-members">
      {group.members.map(([id, breakdown, hungarian, example]) => (
        <li class={id === pointId ? 'self' : undefined}>
          <GroupItem id={id} pointId={pointId} />{' '}
          <span class="group-breakdown">
            = <RichText content={breakdown} />
          </span>{' '}
          <span class="hungarian">– {hungarian}</span>
          {example && (
            <div class="group-member-example">
              <span class="korean">
                <RichText content={example[0]} />
              </span>{' '}
              <span class="hungarian">
                – <RichText content={example[1]} />
              </span>
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>
</details>
