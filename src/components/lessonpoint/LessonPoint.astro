---
import { locate, type PointInfo } from '../../lib/content';
import { relatedBar } from '../../lib/crossReferences';
import { correctIncorrectList } from '../../lib/render/correctIncorrect';
import { forwardMark } from '../../lib/render/forwardReferences';
import { groupsFor } from '../../lib/render/groups';
import { linkPointText, localizePointLinks } from '../../lib/site';
import { soundButton, withSoundButtons } from '../../lib/sound';
import OwnTag from '../OwnTag.astro';
import NounTable from './conjugationTable/NounTable.astro';
import WordTable from './conjugationTable/WordTable.astro';
import GroupBox from './groups/GroupBox.astro';
import Honorifics from './honorific/Honorifics.astro';

interface Props {
  point: PointInfo;
}

const { point } = Astro.props;

const key = `${point.book}-${point.lesson}-${point.point}`;

/** Global ids → links of this page. */
const local = (html: string) => localizePointLinks(html, point.id);
/** Links the lesson references of the text too. */
const linked = (html: string) => linkPointText(html, point.id);
---

<article class="grammar-point" id={locate(point.id)!.anchor} data-book={point.book} data-lesson={point.lesson}>
  <header class="grammar-point-header">
    <div class="grammar-point-number">
      {point.book} · {point.lesson}. lecke · {point.point}. nyelvtan
    </div>
    <h4>
      <span class="korean form">{point.form}</span>
      <span class="grammar-point-name">{point.name}</span>
    </h4>
    <div class="grammar-point-meta">
      <span class="tag textbook">Tankönyv</span>
      <span class="tag future-tag progress-tag">még nem vettük</span>
      <span class="source-reference">
        SB {point.studentBookPage}. o. · VG {point.vocabularyGrammarPage}. o.
      </span>
    </div>
  </header>
  <div class="grammar-point-body">
    <div class="explanation" set:html={linked(point.explanation)} />
    <Fragment set:html={linked(point.customHtml ?? '')} />
    {point.table ? (
      <>
        <h5>Képzés</h5>
        {point.table.kind === 'noun' ? (
          <NounTable table={point.table} key={key} />
        ) : (
          <WordTable table={point.table} key={key} />
        )}
      </>
    ) : (
      ''
    )}
    {!!point.examples && (
      <>
        <h5>Példák</h5>
        <ul class="examples">
          {point.examples.map(([korean, hungarian, note]) => (
            <li>
              <span class="korean">
                <Fragment set:html={korean} />
                <Fragment set:html={soundButton(korean, point.book)} />
              </span>
              <span class="hungarian">
                <Fragment set:html={hungarian} />
                <Fragment set:html={local(forwardMark(point.id, korean))} />
              </span>
              {!!note && <span class="irregular-note">{note}</span>}
            </li>
          ))}
        </ul>
      </>
    )}
    <Fragment set:html={linked(correctIncorrectList(point.correctIncorrect, point.book))} />
    {point.honorific && <Honorifics book={point.book} honorific={point.honorific} pointId={point.id} />}
    {point.ownNote && (
      <aside class="own">
        <div class="own-heading">
          <OwnTag label="＋ Saját kiegészítés" />
        </div>
        <Fragment set:html={linked(withSoundButtons(point.ownNote, point.book))} />
      </aside>
    )}

    {groupsFor(point.id).map(group => (
      <GroupBox group={group} pointId={point.id} />
    ))}
    <Fragment set:html={local(relatedBar(point.id))} />
  </div>
</article>
