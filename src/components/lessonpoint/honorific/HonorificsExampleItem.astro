---
import type { Example } from '../../../data/types';
import { soundButton } from '../../../lib/sound';

interface Props {
  book: string;
  item: Example;
}
const {
  book,
  item: [korean, hungarian, note],
} = Astro.props;
---

<li>
  <span class="korean">
    <Fragment set:html={korean} />
    <Fragment set:html={soundButton(korean, book)} />
  </span>
  <span class="hungarian">{hungarian}</span>
  {note && <span class="irregular-note">{note}</span>}
</li>
