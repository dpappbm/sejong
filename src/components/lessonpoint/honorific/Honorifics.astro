---
import type { Honorific } from '../../../data/types';
import { correctIncorrectList } from '../../../lib/render/correctIncorrect';
import { linkPointText } from '../../../lib/site';
import OwnTag from '../../OwnTag.astro';
import HonorificsExampleItem from './HonorificsExampleItem.astro';
import HonorificsRowItem from './HonorificsRowItem.astro';

interface Props {
  honorific: Honorific;
  book: string;
  pointId: string;
}

const { honorific, book, pointId } = Astro.props;
---

<section class="honorific">
  <h5>
    Tiszteleti alak <OwnTag />
  </h5>
  {!!honorific.rows?.length && (
    <div class="table-wrapper">
      <table class="conjugation-table honorific-table">
        <thead>
          <tr>
            <th>Alap</th>
            <th aria-hidden="true"></th>
            <th>Tiszteleti</th>
          </tr>
        </thead>
        <tbody>
          {honorific.rows.map(item => (
            <HonorificsRowItem item={item} />
          ))}
        </tbody>
      </table>
    </div>
  )}
  <Fragment set:html={linkPointText(honorific.note ?? '', pointId)} />
  {honorific.examples && (
    <ul class="examples">
      {honorific.examples.map(item => (
        <HonorificsExampleItem book={book} item={item} />
      ))}
    </ul>
  )}
  <Fragment set:html={correctIncorrectList(honorific.correctIncorrect, book)} />
</section>
