---
import type { Honorific } from '../../../data/types';
import { correctIncorrectList } from '../../../lib/render/correctIncorrect';
import OwnTag from '../../OwnTag.astro';
import HonorificsExampleItem from './HonorificsExampleItem.astro';
import HonorificsRowItem from './HonorificsRowItem.astro';

interface Props {
  honorific: Honorific | undefined;
  key: string;
  book: string;
}

const { honorific, key, book } = Astro.props;

if (!honorific) return;

// function renderHonorificSection(honorific: Honorific | undefined, key: string, book: string): string {
//   if (!honorific) return '';
//   for (const row of honorific.rows ?? []) {
//     if (row.length < 4 || row.some(cell => !cell))
//       reportProblem(`${key}: incomplete honorific table row: ${row.join(' | ')}`);
//   }
//   if (!honorific.examples || honorific.examples.length < 2)
//     reportProblem(`${key}: honorific section with fewer than 2 examples`);
//   for (const [korean, hungarian] of honorific.examples ?? [])
//     if (!hungarian) reportProblem(`${key}: honorific example without translation: ${korean}`);
//   checkCorrectIncorrect(`${key} honorific`, honorific.correctIncorrect);
// }
---

<section class="honorific">
  <h5>
    Tiszteleti alak <OwnTag />
  </h5>
  {honorific.rows?.length && honorific.rows.length > 0 && (
    <div class="table-wrapper">
      <table class="conjugation-table honorific-table">
        <thead>
          <tr>
            <th>Alap</th>
            <th aria-hidden="true"></th>
            <th>Tiszteleti</th>
          </tr>
        </thead>
        <tbody>
          {honorific.rows.map(item => (
            <HonorificsRowItem item={item} />
          ))}
        </tbody>
      </table>
    </div>
  )}
  <Fragment set:html={honorific.note ?? ''} />
  {honorific.examples && (
    <ul class="examples">
      {honorific.examples.map(item => (
        <HonorificsExampleItem book={book} item={item} />
      ))}
    </ul>
  )}
  <Fragment set:html={correctIncorrectList(honorific.correctIncorrect, book)} />
</section>
