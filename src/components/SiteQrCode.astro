---
// QR code of the site's public address, built from `site` + `base` in astro.config.mjs at build time (inline SVG, no browser JS).
import QRCode from 'qrcode';

if (!Astro.site) throw new Error('SiteQrCode: `site` is not set in astro.config.mjs, the public address is unknown.');
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;
const shownAddress = siteUrl.replace(/^https?:\/\//, '').replace(/\/$/, '');
const svg = await QRCode.toString(siteUrl, { type: 'svg', margin: 1, errorCorrectionLevel: 'M', color: { dark: '#1d2127', light: '#ffffff' } });
---
<div class="site-qr">
  <div class="site-qr-code" role="img" aria-label={`QR-kód: ${siteUrl}`} set:html={svg} />
  <div class="site-qr-caption">Nyisd meg telefonon</div>
  <a class="site-qr-address" href={siteUrl}>{shownAddress}</a>
</div>
