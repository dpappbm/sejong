---
interface Props {
  headers: string[];
  rows: string[][];
}

const { headers, rows } = Astro.props;
---

<div class="table-wrapper">
  <table class="plain">
    <thead>
      <tr>
        {headers.map(header => (
          <th>{header}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map(row => (
        <tr>
          {row.map(cell => (
            <td set:html={cell} />
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
