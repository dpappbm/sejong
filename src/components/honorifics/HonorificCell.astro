---
import type { HonorificPair } from '../../data/types';
import RichText from '../text/RichText.astro';

interface Props {
  pair: HonorificPair | null;
  class?: string;
}

const { pair, class: className } = Astro.props;
---

{pair ? (
  <td class={className}>
    <span class="korean">{pair[0]}</span>
    <span class="translation">
      <RichText content={pair[1]} />
    </span>
  </td>
) : (
  <td class="empty">–</td>
)}
