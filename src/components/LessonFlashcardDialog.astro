---
// The "Gyakorlás" (practice) dialog of a lesson page: choose rows in the row tree, answer a multiple-choice round per row, see
// the summary. Three screens (selection, round, summary) toggled with "hidden"; src/scripts/flashcards.ts drives it.
// A click beside the dialog does not close it, and neither does Esc during a round: only ✕ does.
import type { LessonInfo } from '../lib/content';
import FlashcardGameScreens from './FlashcardGameScreens.astro';
import LessonRowTree from './LessonRowTree.astro';

interface Props {
  lesson: LessonInfo;
}

const { lesson } = Astro.props;
---

<dialog
  class="export-dialog flashcard-dialog"
  id="lesson-flashcard-dialog"
  aria-labelledby="lesson-flashcard-title"
  data-flashcard-scope="lesson"
  data-flashcard-screen="selection"
>
  <header class="export-dialog-header">
    <h2 id="lesson-flashcard-title">
      Gyakorlás
      <span class="export-dialog-lesson">
        {lesson.book} · {lesson.lesson}. lecke
      </span>
    </h2>
    <button class="export-close-icon" type="button" data-flashcard-close aria-label="Bezárás" title="Bezárás">
      ✕
    </button>
  </header>

  <section class="flashcard-screen" data-flashcard-section="selection">
    <div class="export-dialog-body">
      <p class="flashcard-intro">
        Mi kerüljön a kártyák közé? Minden kijelölt sor egyszer lesz kérdés, véletlen sorrendben.
      </p>
      <LessonRowTree lesson={lesson} />
    </div>
    <footer class="export-dialog-footer">
      <span class="flashcard-selection-status" data-flashcard-selection-status role="status" aria-live="polite"></span>
      <button class="dialog-button dialog-primary-button" type="button" data-flashcard-start>
        Indítás
      </button>
      <button class="dialog-button dialog-close-button" type="button" data-flashcard-close>
        Bezárás
      </button>
    </footer>
  </section>

  <FlashcardGameScreens />
</dialog>
