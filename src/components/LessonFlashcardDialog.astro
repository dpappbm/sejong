---
// The "Szókártyák" dialog of a lesson page: choose rows in the row tree, answer a multiple-choice round per row, see
// the summary. Three screens (selection, round, summary) toggled with "hidden"; src/scripts/flashcards.ts drives it.
// A click beside the dialog does not close it, and neither does Esc during a round: only ✕ does.
import type { LessonInfo } from '../lib/content';
import LessonRowTree from './LessonRowTree.astro';

interface Props {
  lesson: LessonInfo;
}

const { lesson } = Astro.props;
---
<dialog class="export-dialog flashcard-dialog" id="lesson-flashcard-dialog" aria-labelledby="lesson-flashcard-title" data-flashcard-screen="selection">
  <header class="export-dialog-header">
    <h2 id="lesson-flashcard-title">Szókártyák <span class="export-dialog-lesson">{lesson.book} · {lesson.lesson}. lecke</span></h2>
    <button class="export-close-icon" type="button" data-flashcard-close aria-label="Bezárás" title="Bezárás">✕</button>
  </header>

  <section class="flashcard-screen" data-flashcard-section="selection">
    <div class="export-dialog-body">
      <p class="flashcard-intro">Mi kerüljön a kártyák közé? Minden kijelölt sor egyszer lesz kérdés, véletlen sorrendben.</p>
      <LessonRowTree lesson={lesson} />
    </div>
    <footer class="export-dialog-footer">
      <button class="dialog-button dialog-primary-button" type="button" data-flashcard-start>Indítás</button>
      <span class="flashcard-selection-status" data-flashcard-selection-status role="status" aria-live="polite"></span>
      <button class="dialog-button dialog-close-button" type="button" data-flashcard-close>Bezárás</button>
    </footer>
  </section>

  <section class="flashcard-screen" data-flashcard-section="round" hidden>
    <div class="export-dialog-body">
      <p class="flashcard-progress" data-flashcard-progress></p>
      <p class="flashcard-question" data-flashcard-question></p>
      <div class="flashcard-answers" data-flashcard-answers role="group" aria-label="Válaszok"></div>
    </div>
    <footer class="export-dialog-footer">
      <span class="flashcard-feedback" data-flashcard-feedback role="status" aria-live="polite"></span>
      <button class="dialog-button dialog-primary-button flashcard-next-button" type="button" data-flashcard-next hidden>Következő</button>
    </footer>
  </section>

  <section class="flashcard-screen" data-flashcard-section="summary" hidden>
    <div class="export-dialog-body">
      <p class="flashcard-score" data-flashcard-score></p>
      <div data-flashcard-mistakes></div>
    </div>
    <footer class="export-dialog-footer">
      <button class="dialog-button dialog-primary-button" type="button" data-flashcard-restart>Újra</button>
      <button class="dialog-button" type="button" data-flashcard-retry-mistakes>Csak a hibásak</button>
      <button class="dialog-button" type="button" data-flashcard-back>Szavak választása</button>
      <button class="dialog-button dialog-close-button" type="button" data-flashcard-close>Bezárás</button>
    </footer>
  </section>
</dialog>
