---
import { LESSONS, lessonPath, withBase, type LessonInfo } from '../lib/content';

interface Props {
  lesson: LessonInfo;
}

const { lesson } = Astro.props;
const index = LESSONS.findIndex(item => item.key === lesson.key);
const previous = LESSONS[index - 1];
const next = LESSONS[index + 1];
---
<nav class="lesson-navigation" aria-label="Előző és következő lecke">
  {previous && (
    <a class="previous" href={withBase(lessonPath(previous.book, previous.lesson))}>
      <span class="direction">← Előző lecke</span>
      <span class="target">{previous.book} · {previous.lesson}. lecke <span class="korean">{previous.title.korean}</span></span>
    </a>
  )}
  {next && (
    <a class="next" href={withBase(lessonPath(next.book, next.lesson))}>
      <span class="direction">Következő lecke →</span>
      <span class="target">{next.book} · {next.lesson}. lecke <span class="korean">{next.title.korean}</span></span>
    </a>
  )}
</nav>
