---
// The collapsed "Szókincs" bar at the end of a lesson: the textbook's words and the own ones.
import entries from '../data/vocabulary';
import VocabularyTable from './VocabularyTable.astro';

interface Props {
  book: string;
  lesson: number;
  path: string;
}

const { book, lesson, path } = Astro.props;
const { textbook = [], own = [] } = entries[`${book}-${lesson}`] ?? {};
const count = textbook.length + own.length;
const tableProps = { book, lesson, path };
---

{count > 0 && (
  <details class="vocabulary">
    <summary>
      <span class="disclosure-arrow" aria-hidden="true"></span>
      <b>Szókincs</b>
      <span class="count">{count} szó</span>
    </summary>
    <div class="vocabulary-body">
      {textbook.length > 0 && (
        <div class="vocabulary-part">
          <div class="vocabulary-heading">Tankönyv</div>
          <VocabularyTable rows={textbook} {...tableProps} />
        </div>
      )}
      {own.length > 0 && (
        <aside class="own vocabulary-part vocabulary-own">
          <div class="own-heading">
            <span class="tag own">＋ Saját</span> <b>További szavak</b>
          </div>
          <VocabularyTable rows={own} {...tableProps} />
        </aside>
      )}
    </div>
  </details>
)}
