---
// The round and summary screens of the flash-card game, shared by the lesson and the book practice dialogs
// (src/scripts/flashcards.ts drives them). A book game also shows the rows left and the "hibásak is" checkbox.
interface Props {
  book?: boolean;
}

const { book = false } = Astro.props;
---

<section class="flashcard-screen" data-flashcard-section="round" hidden>
  <div class="export-dialog-body">
    <p class="flashcard-progress" data-flashcard-progress></p>
    <p class="flashcard-question" data-flashcard-question></p>
    <div class="flashcard-answers" data-flashcard-answers role="group" aria-label="Válaszok"></div>
  </div>
  <footer class="export-dialog-footer">
    <span class="flashcard-feedback" data-flashcard-feedback role="status" aria-live="polite"></span>
    <button class="dialog-button dialog-primary-button flashcard-next-button" type="button" data-flashcard-next hidden>
      Következő
    </button>
  </footer>
</section>

<section class="flashcard-screen" data-flashcard-section="summary" hidden>
  <div class="export-dialog-body">
    <p class="flashcard-score" data-flashcard-score></p>
    {book && <p class="flashcard-remaining" data-flashcard-remaining></p>}
    <div data-flashcard-mistakes></div>
  </div>
  <footer class="export-dialog-footer">
    <button class="dialog-button dialog-primary-button" type="button" data-flashcard-restart>
      Újra
    </button>
    {book && (
      <label class="flashcard-include-mistakes" data-flashcard-include-mistakes-label>
        <input type="checkbox" data-flashcard-include-mistakes /> a hibásak is jöhetnek újra
      </label>
    )}
    <button class="dialog-button" type="button" data-flashcard-retry-mistakes>
      Csak a hibásak
    </button>
    <button class="dialog-button" type="button" data-flashcard-back>
      Szavak választása
    </button>
    <button class="dialog-button dialog-close-button" type="button" data-flashcard-close>
      Bezárás
    </button>
  </footer>
</section>
