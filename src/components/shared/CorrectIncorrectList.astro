---
// The ✅/❌ usage samples of grammar points, honorific sections, related-structure boxes and honorific word categories.
import type { CorrectIncorrect } from '../../data/types';
import SoundButton from '../SoundButton.astro';

interface Props {
  items: CorrectIncorrect[];
  /** With a book, the correct samples get a play button (the incorrect ones never do). */
  book?: string;
}

const { items, book } = Astro.props;
---

<ul class="correct-incorrect">
  {items.map(item =>
    'correct' in item ? (
      <li class="correct">
        <span class="korean">
          {item.correct}
          {book && <SoundButton korean={item.correct} />}
        </span>
        <span class="hungarian">{item.translation}</span>
        {item.note && <span class="correct-incorrect-note">{item.note}</span>}
      </li>
    ) : (
      <li class="incorrect">
        <span class="korean">{item.incorrect}</span>
        {item.translation && <span class="hungarian">{item.translation}</span>}
        <span class="correct-incorrect-note">{item.reason}</span>
      </li>
    )
  )}
</ul>
