---
// The ✅/❌ usage samples of grammar points, honorific sections, related-structure boxes and honorific word categories.
import type { CorrectIncorrect } from '../../data/types';
import type { TextPlace } from '../../lib/richText';
import SoundButton from '../SoundButton.astro';
import RichText from '../text/RichText.astro';

interface Props {
  items: CorrectIncorrect[];
  /** With a place, the correct samples and corrections get a play button (the incorrect ones never do). */
  place?: TextPlace;
}

const { items, place } = Astro.props;
---

<ul class="correct-incorrect">
  {items.map(item =>
    'correct' in item ? (
      <li class="correct">
        <span class="korean">
          <RichText content={item.correct} />
          <SoundButton korean={item.correct} book={place?.book} />
        </span>
        <span class="hungarian">
          <RichText content={item.translation} />
        </span>
        {item.note && (
          <span class="correct-incorrect-note">
            <RichText content={item.note} />
          </span>
        )}
      </li>
    ) : (
      <li class="incorrect">
        <span class="korean">
          <RichText content={item.incorrect} />
        </span>
        <span class="correct-incorrect-note">
          <RichText content={item.reason} />
        </span>
        {item.correction && (
          <span class="correct-incorrect-correction">
            <span>
              <span class="correct-incorrect-correction-label">✅ helyette helyesen:</span>{' '}
              <span class="korean">
                <RichText content={item.correction.correct} />
                <SoundButton korean={item.correction.correct} book={place?.book} />
              </span>
            </span>
            <span class="hungarian">
              <RichText content={item.correction.translation} />
            </span>
            {item.correction.note && (
              <span class="correct-incorrect-note">
                <RichText content={item.correction.note} />
              </span>
            )}
          </span>
        )}
      </li>
    )
  )}
</ul>
