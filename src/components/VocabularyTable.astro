---
// One word list of the "Szókincs" bar: Korean, Hungarian and the mark of a structure taught later.
import type { VocabularyRow } from '../data/types';
import type { TextPlace } from '../lib/richText';
import { vocabularyUses } from '../lib/vocabulary';
import SoundButton from './SoundButton.astro';
import ForwardReferences from './text/ForwardReferences.astro';

interface Props {
  rows: VocabularyRow[];
  place: TextPlace;
  /** Whether the words get a play button. */
  hasSound?: boolean;
}

const { rows, place, hasSound = false } = Astro.props;
---

<div class="table-wrapper">
  <table class="plain vocabulary-table">
    <thead>
      <tr>
        <th>Koreai</th>
        <th>Magyarul</th>
      </tr>
    </thead>
    <tbody>
      {rows.map(row => {
        const [korean, hungarian] = row;
        return (
          <tr class="vocabulary-row">
            <td class="korean">
              {korean}
              {hasSound && <SoundButton korean={korean} book={place.book} />}
            </td>
            <td>
              {hungarian}
              <ForwardReferences uses={vocabularyUses(row)} place={place} />
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
