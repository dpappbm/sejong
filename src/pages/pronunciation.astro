---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackButton from '../components/BackButton.astro';
import PageNavigation from '../components/PageNavigation.astro';
import PronunciationCategoryCard from '../components/pronunciation/PronunciationCategoryCard.astro';
import pronunciation from '../data/pronunciation';
import { CHAPTER_PATHS } from '../lib/content';
---

<BaseLayout
  title="Kiejtés – 한국어 문법"
  pageLabel="Kiejtés"
  description="A tankönyvi „발음” dobozok szabálytípus szerint, példákkal és magyar fordítással."
>
  <BackButton />
  <PageNavigation path={CHAPTER_PATHS.pronunciation} />
  <section class="chapter-section pronunciation-chapter">
    <h2>
      <span class="level-badge" style="background:var(--accent)">
        ♪
      </span>
      Kiejtés <span class="korean">(발음)</span>
    </h2>
    <p class="pronunciation-chapter-intro">
      A tankönyvi „발음” dobozok szabálytípus szerint. Mindegyiknél ott a tankönyvi mintaszó és a gyakorló példák a
      kiejtéssel, magyar fordítással és a lecke linkjével. A gyakorló példák kiejtését a tankönyv nem írja ki; ez a
      lecke szabályának alkalmazása.
    </p>
    {pronunciation.categories.map(category => (
      <PronunciationCategoryCard category={category} />
    ))}
  </section>
  <PageNavigation path={CHAPTER_PATHS.pronunciation} />
</BaseLayout>
