---
import BaseLayout from '../layouts/BaseLayout.astro';
import BackButton from '../components/BackButton.astro';
import HonorificCategoryCard from '../components/honorifics/HonorificCategoryCard.astro';
import PageNavigation from '../components/PageNavigation.astro';
import Blocks from '../components/text/Blocks.astro';
import honorifics from '../data/honorifics';
import { CHAPTER_PATHS } from '../lib/content';
---

<BaseLayout
  title="Tiszteleti szavak – 한국어 문법"
  pageLabel="Tiszteleti szavak"
  description="Tiszteleti és szerény szavak (높임말): partikulák, főnevek, igék, szerény alakok és megszólítás."
>
  <BackButton />
  <PageNavigation path={CHAPTER_PATHS.honorifics} />
  <section class="chapter-section honorifics-chapter">
    <h2>
      <span class="level-badge chapter-badge">◆</span>
      Tiszteleti szavak <span class="korean">(높임말)</span> <span class="tag own">＋ Saját összeállítás</span>
    </h2>
    <Blocks content={honorifics.intro} />
    {honorifics.categories.map((category, index) => (
      <HonorificCategoryCard category={category} index={index} />
    ))}
  </section>
  <PageNavigation path={CHAPTER_PATHS.honorifics} />
</BaseLayout>
