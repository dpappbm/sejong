---
import BackButton from '../components/BackButton.astro';
import Basics from '../components/basics/Basics.astro';
import PageNavigation from '../components/PageNavigation.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CHAPTER_PATHS } from '../lib/content';
import { getSite } from '../lib/site';

getSite(); // registers the references before the cards render
---

<BaseLayout
  title="Alapszabályok – 한국어 문법"
  pageLabel="Alapszabályok"
  description="Alapszabályok: szótő, 받침, a -아/어 összevonás, rendhagyó igék, partikulák, jelzői alakok és beszédszintek."
>
  <BackButton />
  <PageNavigation path={CHAPTER_PATHS.basics} />
  <section class="chapter-section">
    <h2>
      <span class="level-badge" style="background:var(--accent)">
        ★
      </span>
      Alapszabályok <span class="tag own">＋ Saját összefoglaló</span>
    </h2>
    <Basics />
  </section>
  <PageNavigation path={CHAPTER_PATHS.basics} />
</BaseLayout>
