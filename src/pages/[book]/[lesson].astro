---
import BackButton from '../../components/BackButton.astro';
import LessonExportDialog from '../../components/LessonExportDialog.astro';
import LessonFlashcardDialog from '../../components/LessonFlashcardDialog.astro';
import LessonHeader from '../../components/LessonHeader.astro';
import LessonPoint from '../../components/lessonpoint/LessonPoint.astro';
import PageNavigation from '../../components/PageNavigation.astro';
import PronunciationBox from '../../components/pronunciation/PronunciationBox.astro';
import Vocabulary from '../../components/Vocabulary.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LESSONS, LEVELS, lessonPath, type LessonInfo } from '../../lib/content';
import { lessonExportEnabled } from '../../lib/features';

export function getStaticPaths() {
  return LESSONS.map(lesson => ({
    params: { book: lesson.book.toLowerCase(), lesson: String(lesson.lesson) },
    props: { lesson },
  }));
}

interface Props {
  lesson: LessonInfo;
}

const { lesson } = Astro.props;
const level = LEVELS.find(item => item.books.includes(lesson.book))!;
const path = lessonPath(lesson.book, lesson.lesson);
const label = `${lesson.book} ${lesson.lesson}. lecke`;
---

<BaseLayout
  title={`${label}: ${lesson.title.korean} – 한국어 문법`}
  description={`${label} (${lesson.title.hungarian}): ${lesson.points.map(point => point.form).join(', ')}`}
  pageLabel={label}
  lesson={lesson}
>
  <BackButton />
  <PageNavigation path={path} />
  <section
    class={`lesson lesson-page level-${level.color}`}
    id="lesson"
    data-book={lesson.book}
    data-lesson={lesson.lesson}
  >
    <LessonHeader lesson={lesson} />
    <div class="lesson-sticky-bar" aria-hidden="true" title="A lecke elejére">
      <span class="lesson-label">
        {lesson.book} · {lesson.lesson}. lecke
      </span>
      <span class="tag current-lesson">itt tartasz</span>
      <span class="korean">{lesson.title.korean}</span>
    </div>
    {lesson.points.map(point => (
      <LessonPoint point={point} />
    ))}
    <PronunciationBox lesson={lesson} />
    <Vocabulary lesson={lesson} />
  </section>
  {lessonExportEnabled && <LessonExportDialog lesson={lesson} />}
  <LessonFlashcardDialog lesson={lesson} />
  <PageNavigation path={path} />
</BaseLayout>
